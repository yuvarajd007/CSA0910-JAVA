import java.util.Scanner;

interface Chargeable {
    double chargingFee(int kWh);
}

abstract class Vehicle {
    private final String regNo;

    protected Vehicle(String regNo) {
        this.regNo = regNo;
    }

    public String getRegNo() {
        return regNo;
    }

    protected abstract double ratePerHour();

    public double calculateFee(int minutes) {
        int hours = (minutes + 59) / 60;
        return hours * ratePerHour();
    }

    @Override
    public boolean equals(Object obj) {
        return obj instanceof Vehicle &&
                regNo.equals(((Vehicle) obj).regNo);
    }

    @Override
    public int hashCode() {
        return regNo.hashCode();
    }
}

class TwoWheeler extends Vehicle {
    TwoWheeler(String regNo) {
        super(regNo);
    }

    @Override
    protected double ratePerHour() {
        return 10;
    }
}

class Car extends Vehicle {
    Car(String regNo) {
        super(regNo);
    }

    @Override
    protected double ratePerHour() {
        return 30;
    }
}

class ElectricCar extends Car implements Chargeable {
    ElectricCar(String regNo) {
        super(regNo);
    }

    @Override
    public double chargingFee(int kWh) {
        return kWh * 12;
    }
}

public class FeeDemo {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        Vehicle[] parked = {
            new TwoWheeler("TN01A1"),
            new Car("TN02B2"),
            new ElectricCar("TN03C3")
        };

        System.out.print("Enter parking duration in minutes: ");
        int minutes = sc.nextInt();

        System.out.print("Enter EV charging units in kWh: ");
        int units = sc.nextInt();

        for (Vehicle v : parked) {
            double fee = v.calculateFee(minutes);

            if (v instanceof Chargeable) {
                fee += ((Chargeable) v).chargingFee(units);
            }

            System.out.println(v.getClass().getSimpleName()
                    + " " + v.getRegNo() + " -> Rs " + fee);
        }

        System.out.println(
            new Car("TN02B2").equals(new ElectricCar("TN02B2"))
        );

        sc.close();
    }
}
