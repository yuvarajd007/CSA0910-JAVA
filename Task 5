import java.util.Scanner;

class Ticket {
    private static int nextNumber = 1000;
    private final int ticketNo;
    private final String regNo;

    Ticket(String regNo) {
        ticketNo = nextNumber++;
        this.regNo = regNo;
    }

    void display() {
        System.out.println("Ticket " + ticketNo + " for " + regNo);
    }

    static void showNextNumber() {
        System.out.println("Next ticket number: " + nextNumber);
    }
}

public class Task05 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter first vehicle registration: ");
        Ticket t1 = new Ticket(sc.nextLine());

        System.out.print("Enter second vehicle registration: ");
        Ticket t2 = new Ticket(sc.nextLine());

        t1.display();
        t2.display();
        Ticket.showNextNumber();

        sc.close();
    }
}
